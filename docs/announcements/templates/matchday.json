            "type": "text",
            "default": "SAMSTAG"
        },
        {
            "id": "date",
            "label": "Datum",
            "type": "text",
            "default": "22.08.2026"
        },
        {
            "id": "time",
            "label": "Anwurf",
            "type": "text",
            "default": "17:00"
        },
        {
            "id": "homeTeam",
            "label": "Heimteam",
            "type": "text",
